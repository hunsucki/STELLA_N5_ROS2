<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <!-- Separate local control transmission from the Wi-Fi send queue. -->
        <NetworkInterface name="lo" multicast="true" priority="10"/>
        <NetworkInterface name="wlan0" multicast="true" priority="0"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <!-- Keep discovering external ROS nodes on wlan0 as well as local ones. -->
      <MulticastRecvNetworkInterfaceAddresses>all</MulticastRecvNetworkInterfaceAddresses>
    </General>
    <Discovery>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
