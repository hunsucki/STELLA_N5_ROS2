# STELLA serial device names.
#
# Current USB layout:
# - Front upper RPLIDAR: CP2102N serial 4a237fb90464ef11947fe2a9c169b110
# - Rear upper docking RPLIDAR: CP2102N serial ccaf2ee0ed63ef11b4dddaa9c169b110
# - SK120 USB-TTL: PL2303 on hub port 4-1.2
# - AHRS: FT230X
# - Motor driver: FT232R

KERNEL=="ttyUSB*", ENV{ID_SERIAL_SHORT}=="4a237fb90464ef11947fe2a9c169b110", MODE:="0777", SYMLINK+="RPLIDAR"
KERNEL=="ttyUSB*", ENV{ID_SERIAL_SHORT}=="ccaf2ee0ed63ef11b4dddaa9c169b110", MODE:="0777", SYMLINK+="RPLIDAR2"

KERNEL=="ttyUSB*", KERNELS=="4-1.2", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", MODE:="0777", SYMLINK+="SK120"
KERNEL=="ttyUSB*", KERNELS=="3-1.2", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", MODE:="0777", SYMLINK+="SK120"

KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", MODE:="0777", SYMLINK+="AHRS"
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE:="0777", SYMLINK+="MW"

# Raspberry Pi 5 on-board devices used by the Python hardware nodes.
# gpiozero selects gpiochip4 for the 40-pin header and the INA219 is on I2C bus 1.
# These nodes are launched as the desktop user, so they must not inherit the
# Ubuntu default root:dialout 0660 permissions on systems where that user is not
# a member of dialout.
SUBSYSTEM=="gpio", KERNEL=="gpiochip4", GROUP:="plugdev", MODE:="0660"
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-1", GROUP:="plugdev", MODE:="0660"

# Microsoft Xbox Bluetooth gamepad input. ROS joy uses the evdev event node,
# which Ubuntu otherwise creates as root:input 0660. STELLA processes run as a
# desktop user in plugdev, so grant that group access without opening all input
# devices system-wide.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="045e", ENV{ID_INPUT_JOYSTICK}=="1", GROUP:="plugdev", MODE:="0660"
SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="045e", ENV{ID_INPUT_JOYSTICK}=="1", GROUP:="plugdev", MODE:="0660"

# set the udev rule, make the Bluetooth's device_port be fixed by BT

KERNEL=="ttyS*", MODE:="0777", SYMLINK+="BT"

# set the udev rule, make the realsense's device_port

SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07", MODE:="0777"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE:="0777"
KERNEL=="iio*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE:="0777", RUN+="/bin/sh -c 'chmod -R 0777 /sys/%p'"
DRIVER=="hid_sensor*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", RUN+="/bin/sh -c ' chmod -R 0777 /sys/%p && chmod 0777 /dev/%k'"
# For products with motion_module, if (kernels is 4.15 and up) and (device name is "accel_3d") wait, in another process, until (enable flag is set to 1 or 200 mSec passed) and then set it to 0.
# KERNEL=="iio*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", RUN+="/bin/sh -c '(major=`uname -r | cut -d \".\" -f1` && minor=`uname -r | cut -d \".\" -f2` && (([ $$major -eq 4 ] && [ $$minor -ge 15 ]) || [ $$major -ge 5 ])) && (enamefile=/sys/%p/name && [ `cat $$enamefile` = \"accel_3d\" ]) && enfile=/sys/%p/buffer/enable && echo \"COUNTER=0; while [ \$$COUNTER -lt 20 ] && grep -q 0 $$enfile; do sleep 0.01; COUNTER=\$$((COUNTER+1)); done && echo 0 > $$enfile\" | at now'"
